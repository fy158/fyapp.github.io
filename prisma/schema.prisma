generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= 用户表 =============
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatar    String   @default("/images/avatar-default.jpg")
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles   Article[]
  comments   Comment[]
  wishes     Wish[]
  blessings  Blessing[]
  photos     Photo[]
}

// ============= 文章分类 =============
model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  count    Int     @default(0)

  articles Article[]
}

// ============= 文章 =============
model Article {
  id              String    @id @default(cuid())
  title           String
  content         String
  excerpt         String?
  categoryName   String
  coverImage      String    @default("/images/story-default.jpg")
  views           Int       @default(0)
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  cat       Category  @relation(fields: [categoryName], references: [name])
  comments  Comment[]
}

// ============= 评论 =============
model Comment {
  id        String   @id @default(cuid())
  content   String
  articleId String
  authorId  String
  parentId  String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
}

// ============= 许愿池 =============
model Wish {
  id          String   @id @default(cuid())
  content     String
  author      String
  authorId    String?
  likes       Int      @default(0)
  emoji       String   @default("✨")
  borderColor String   @default("from-pink-400 to-purple-400")
  createdAt   DateTime @default(now())

  user User? @relation(fields: [authorId], references: [id])
}

// ============= 祝福板 =============
model Blessing {
  id          String   @id @default(cuid())
  author      String
  content     String
  avatarColor String   @default("from-pink-400 to-rose-400")
  isVIP       Boolean  @default(false)
  authorId    String?
  createdAt   DateTime @default(now())

  user     User?          @relation(fields: [authorId], references: [id])
  replies  BlessingReply[]
}

// ============= 祝福回复 =============
model BlessingReply {
  id          String   @id @default(cuid())
  author      String
  content     String
  toUser      String?
  blessingId  String
  createdAt   DateTime @default(now())

  blessing Blessing @relation(fields: [blessingId], references: [id], onDelete: Cascade)
}

// ============= 相册照片 =============
model Photo {
  id        String   @id @default(cuid())
  title     String
  src       String
  category  String   @default("日常")
  date      String
  authorId  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [authorId], references: [id])
}

// ============= 站点统计 =============
model SiteStats {
  id        String  @id @default("main")
  articles  Int     @default(0)
  views     Int     @default(0)
  wishes    Int     @default(0)
  blessings Int     @default(0)
  updatedAt DateTime @updatedAt
}

// ============= 心情天气记录 =============
model MoodWeather {
  id        String   @id @default(cuid())
  moodId    String   // sunny, partly-cloudy, cloudy, rainy, stormy, rainbow
  label     String   // 超级开心, 心情不错, etc.
  icon      String   // emoji
  note      String?  // 心情备注
  color     String   // gradient color class
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  date      String   @unique // YYYY-MM-DD format for daily tracking
}

// ============= 情绪记录 =============
model EmotionRecord {
  id        String   @id @default(cuid())
  emotionId String   // happy, love, calm, sad, angry, anxious
  emotion   String   // 开心, 爱意, calm, etc.
  level     Int      // 1-5 intensity
  icon      String   // emoji
  note      String?  // 备注
  createdAt DateTime @default(now())
}

// ============= 每日心情标记 =============
model DailyMood {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  mood      String   // happy, sad, angry, calm, excited, tired
  emoji     String   // 😊, 😢, etc.
  note      String?  // 备注
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= 恋爱日记 =============
model LoveDiary {
  id        String   @id @default(cuid())
  title     String
  content   String
  mood      String? // 日记时的心情
  date      DateTime? @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============= 纪念日 =============
model Anniversary {
  id           String   @id @default(cuid())
  title        String
  date         DateTime  // 纪念日期
  description  String?  // 描述
  icon         String?  // emoji 图标
  color        String   @default("from-pink-400 to-rose-400") // 渐变色
  isRecurring  Boolean  @default(true) // 是否每年重复
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============= 甜蜜清单 =============
model SweetBucketList {
  id           String   @id @default(cuid())
  title        String
  description  String?  // 详细描述
  category     String?  // place, food, plan, other
  completed    Boolean  @default(false)
  completedDate DateTime? // 完成时间
  targetDate   DateTime? // 目标完成日期
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============= 悄悄话信箱 =============
model SecretMessage {
  id        String   @id @default(cuid())
  author    String   @default("匿名") // 发送者昵称
  content   String
  isRead    Boolean  @default(false)
  readDate  DateTime?
  reply     String?  // 回复内容
  createdAt DateTime @default(now())
  replyAt   DateTime?
}

// ============= AI 生成内容 =============
model AIGenerateContent {
  id          String   @id @default(cuid())
  description String
  title       String?
  type        String   // HTML文件 / image
  url         String?  // HTML文件URL或图片URL
  coverImage  String? // 封面图片URL
  icon        String? // 图标emoji或SVG
  category    String   // 'tool' | 'image'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============= 链接收藏（一封未尽的情书） =============
model LinkCollection {
  id         String   @id @default(cuid())
  title      String
  description String? // 说明性文字
  url        String   // 跳转网址
  coverImage String?  // 封面图片URL
  icon       String?  // 图标emoji
  order      Int      @default(0) // 排序
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}